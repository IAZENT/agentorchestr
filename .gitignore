# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
*.egg

# Virtualenv
.env/
.venv/
venv/
env/

# Environment variables (secrets)
.env.local
.env.*.local

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# agentorchestr runtime artifacts (per-session ephemeral state goes here;
# the per-project markdown that lives under .agentorchestr/ IS git-trackable
# — see paths.py and the README — so we only ignore noise.)
.agentorchestr/cache/
.agentorchestr/*.log
.agentorchestr/memory/index.sqlite
.agentorchestr/memory/session_*.md

# Local agent settings (user-specific)
.openclaude/
.claude/
.kiro/
.copilot/

# Chat & misc
chathistory.json
*.log

# Databases (top-level only; in-repo .agentorchestr/memory/index.sqlite
# is covered above.)
/*.db
/*.sqlite
/*.sqlite3

# Pytest / mypy / coverage
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/
.nox/

# Secrets / credentials
*.pem
*.key
*.cert
*.crt
secrets.json
credentials.json
token.json

# Node (if dashboard has JS deps)
node_modules/
npm-debug.log*

# Docker
.docker/
docker-compose.override.yml

# Working files (ignore drafts, but RESEARCH.md / CHANGELOG.md ARE tracked).
NOTES.md
TODO.md
RESEARCH.md
CHANGELOG.md